# Copy to .env and fill in what you need. Nothing here is required to run
# the app locally — every var has a code default; this file just documents
# what's tunable without a redeploy and what secrets the app expects.

# ---- Alerting (alerts.js) — leave unset to skip that channel ----
SLACK_WEBHOOK_URL=
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# ---- Server ----
# PORT=3000
# NODE_ENV=production
# AUTO_OPEN_BROWSER=false
# PUBLIC_BASE_URL=https://checker.example.com

# ---- Crawl / audit tuning ----
# MAX_CRAWL_PAGES=20
# ABSOLUTE_MAX_PAGES=50
# AUDIT_CONCURRENCY=4
# PAGE_NAVIGATION_TIMEOUT_MS=30000
# BOT_CHALLENGE_TIMEOUT_MS=8000
# LOW_PAGE_YIELD_THRESHOLD=5
# BROWSER_IDLE_TIMEOUT_MS=60000
# SCAN_USER_AGENT=

# ---- Chrome (usually only needed outside this repo's Dockerfile) ----
# CHROME_BIN=
# CHROMIUM_BIN=
