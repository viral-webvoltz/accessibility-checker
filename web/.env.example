# Where the scanner backend lives.
#   Local:      http://localhost:4000   (npm run dev in the repo root)
#   Production: your Lambda Function URL, e.g. https://abc123.lambda-url.us-east-1.on.aws
NEXT_PUBLIC_SCANNER_URL=http://localhost:4000

# Optional: Cloudflare Turnstile site key (pairs with TurnstileSecret in the SAM deploy).
# Leave empty to turn the human check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
